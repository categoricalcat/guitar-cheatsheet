{
	"name": "guitar-cheatsheet",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings && tsc -p src/service-worker && tsc -p tsconfig.test.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "node --test \"src/**/*.test.ts\""
	},
	"devDependencies": {
		"@sveltejs/adapter-static": "4.0.1",
		"@sveltejs/kit": "3.1.1",
		"@sveltejs/vite-plugin-svelte": "7.3.1",
		"@types/node": "26.6.6",
		"svelte": "5.57.3",
		"svelte-check": "4.7.7",
		"typescript": "6.0.3",
		"vite": "8.3.5"
	},
	"imports": {
		"#lib/*": "./src/lib/*"
	},
	"dependencies": {
		"@tombatossals/chords-db": "0.5.1",
		"pitchy": "4.1.0",
		"svguitar": "2.10.1",
		"tonal": "6.5.1"
	}
}
