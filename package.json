{
	"name": "guitar-cheatsheet",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"engines": {
		"node": "26.13.0"
	},
	"scripts": {
		"build": "vite build",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings && tsc -p src/service-worker && tsc -p tsconfig.test.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"dev": "vite dev",
		"fix": "npm run lint:fix && npm run format",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"lint": "svelte-kit sync && eslint . --max-warnings 0",
		"lint:fix": "svelte-kit sync && eslint . --fix",
		"prepare": "svelte-kit sync",
		"preview": "vite preview",
		"test": "node --test \"src/**/*.test.ts\"",
		"verify": "npm run format:check && npm run lint && npm run check && npm test && npm run build",
		"verify:nix": "statix check flake.nix && deadnix --fail flake.nix && nixfmt --check flake.nix && nix flake check --no-build"
	},
	"devDependencies": {
		"@eslint/js": "10.0.1",
		"@sveltejs/adapter-static": "4.0.1",
		"@sveltejs/kit": "3.1.1",
		"@sveltejs/load-config": "0.2.3",
		"@sveltejs/vite-plugin-svelte": "7.3.1",
		"@types/node": "26.6.6",
		"eslint": "10.14.0",
		"eslint-config-prettier": "10.1.8",
		"eslint-plugin-perfectionist": "5.13.0",
		"eslint-plugin-svelte": "3.23.1",
		"globals": "17.13.0",
		"jiti": "2.7.0",
		"prettier": "3.9.10",
		"prettier-plugin-svelte": "4.1.1",
		"svelte": "5.57.3",
		"svelte-check": "4.7.7",
		"typescript": "6.0.3",
		"typescript-eslint": "8.72.1",
		"vite": "8.3.5"
	},
	"imports": {
		"#lib/*": "./src/lib/*"
	},
	"dependencies": {
		"@tombatossals/chords-db": "0.5.1",
		"pitchy": "4.1.0",
		"svguitar": "2.10.1",
		"tonal": "6.5.1"
	}
}
